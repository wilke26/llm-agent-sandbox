# Container identity. On native Linux, match these to the owner of workspace/ if needed.
COMPOSE_PROJECT_NAME=llm-agent-sandbox
AGENT_UID=10001
AGENT_GID=10001

# Local image name and runtime limits.
AGENT_IMAGE=llm-agent-sandbox:local
AGENT_MEMORY_LIMIT=2g
AGENT_CPU_LIMIT=2.0
AGENT_PIDS_LIMIT=128
AGENT_NOFILE_SOFT=1024
AGENT_NOFILE_HARD=2048
AGENT_TMPFS_SIZE=256m
AGENT_CACHE_SIZE=128m

# Never put API keys, passwords, tokens or host paths in this file.
